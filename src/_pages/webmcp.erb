---
layout: none
permalink: /javascript/webmcp.js
sitemap: false
template_engine: erb
---
<%
  pricing = site.data["webmcp"]["pricing"]
  features = site.data["webmcp"]["features"]
  links = site.data["webmcp"]["links"]
  blog_index = site.collections.posts.resources
    .reject { |p| p.data.published == false }
    .reject { |p| p.data.dig("SEO_options", "prevent_indexing") }
    .map do |p|
      {
        title: p.data.title,
        url: p.relative_url,
        date: p.data.date.is_a?(Time) ? p.data.date.strftime("%Y-%m-%d") : p.data.date.to_s,
        description: p.data.dig("SEO_options", "description") || p.data.blurb || ""
      }
    end
%>
// WebMCP — Causey
// Exposes site-level tools to AI agents via navigator.modelContext.registerTool.
// Spec: https://webmachinelearning.github.io/webmcp/ (Draft Community Group Report).
// Generated from src/_data/webmcp.yml + src/_posts/. Do not edit /javascript/webmcp.js directly.
(function () {
  if (typeof navigator === "undefined") return;
  if (!navigator.modelContext || typeof navigator.modelContext.registerTool !== "function") return;

  var PRICING = <%== pricing.to_json %>;
  var FEATURES = <%== features.to_json %>;
  var LINKS = <%== links.to_json %>;
  var BLOG_INDEX = <%== blog_index.to_json %>;

  function navigateTo(url) {
    try { window.location.assign(url); } catch (e) {}
    return { ok: true, navigated_to: url };
  }

  function buildQuery(params) {
    var pairs = [];
    Object.keys(params || {}).forEach(function (k) {
      var v = params[k];
      if (v === undefined || v === null || v === "") return;
      pairs.push(encodeURIComponent(k) + "=" + encodeURIComponent(v));
    });
    return pairs.length ? "?" + pairs.join("&") : "";
  }

  function safeRegister(tool) {
    try { navigator.modelContext.registerTool(tool); }
    catch (e) { /* registration failure on one tool shouldn't block others */ }
  }

  safeRegister({
    name: "get_pricing",
    description: "Return Causey's current pricing tiers (Basic, Lite, Core, Solid), what's included, the annual discount, free trial details, and per-tier sign-up URLs.",
    inputSchema: { type: "object", properties: {} },
    annotations: { readOnlyHint: true },
    execute: function () { return Promise.resolve(PRICING); }
  });

  safeRegister({
    name: "list_features",
    description: "Return Causey's product capabilities. Optionally filter to a category: planning, metrics, reminders, comments, reporting, guidance, unlimited_users.",
    inputSchema: {
      type: "object",
      properties: {
        category: {
          type: "string",
          enum: Object.keys(FEATURES),
          description: "Filter to a single feature category."
        }
      }
    },
    annotations: { readOnlyHint: true },
    execute: function (args) {
      args = args || {};
      if (args.category && FEATURES[args.category]) {
        var single = {};
        single[args.category] = FEATURES[args.category];
        return Promise.resolve(single);
      }
      return Promise.resolve(FEATURES);
    }
  });

  safeRegister({
    name: "search_blog",
    description: "Search Causey's blog posts by query string. Returns up to 10 matches with title, URL, date, and description.",
    inputSchema: {
      type: "object",
      properties: {
        query: { type: "string", description: "Free-text query matched against title and description." },
        limit: { type: "integer", minimum: 1, maximum: 25, default: 10 }
      }
    },
    annotations: { readOnlyHint: true },
    execute: function (args) {
      args = args || {};
      var q = (args.query || "").toLowerCase().trim();
      var limit = Math.min(Math.max(args.limit || 10, 1), 25);

      var matches = BLOG_INDEX.filter(function (p) {
        if (!q) return true;
        var hay = (p.title + " " + (p.description || "")).toLowerCase();
        return hay.indexOf(q) !== -1;
      });

      matches.sort(function (a, b) { return (b.date || "").localeCompare(a.date || ""); });
      return Promise.resolve(matches.slice(0, limit));
    }
  });

  safeRegister({
    name: "start_trial",
    description: "Open Causey's 30-day free trial sign-up flow. Optionally pre-select a tier (basic, lite, core, or solid) to land on the right sign-up URL. Annual cycle saves 16%.",
    inputSchema: {
      type: "object",
      properties: {
        tier: {
          type: "string",
          enum: ["basic", "lite", "core", "solid"],
          description: "Tier to sign up for."
        },
        cycle: {
          type: "string",
          enum: ["monthly", "annual"],
          default: "monthly",
          description: "Billing cycle. Annual saves 16%."
        }
      }
    },
    execute: function (args) {
      args = args || {};
      var tier = args.tier;
      var cycle = args.cycle || "monthly";

      var url = LINKS.trial;
      if (tier === "basic") {
        url = "https://www.causey.app/causey-basic-tier/";
      } else if (tier && PRICING[tier]) {
        var key = cycle === "annual" ? "sign_up_annual" : "sign_up_monthly";
        url = PRICING[tier][key] || LINKS.trial;
      }

      var sep = url.indexOf("?") === -1 ? "?" : "&";
      return Promise.resolve(navigateTo(url + sep + "utm_source=mcp&utm_medium=agent"));
    }
  });

  safeRegister({
    name: "book_demo",
    description: "Open Causey's demo booking page on Calendly with the founder, Ricky Chilcott. 30-minute walkthrough.",
    inputSchema: { type: "object", properties: {} },
    execute: function () {
      return Promise.resolve(navigateTo(LINKS.demo));
    }
  });
})();
