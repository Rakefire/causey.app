---
layout: default
---
{% assign l = "archive-layout" %}
{% assign archive_filter_tag = page.original_title | default: page.title %}
<div class="{{l}}">
	<h1 class="{{l}}__heading">Blog</h1>

	<div class="{{l}}__tags">
		<span class="{{l}}__tag"><a href="/blog/">{{ page.title }} &#215;</a></span>
	</div>

	{% bookshop posts-list
		show_posts=true
		tag=archive_filter_tag %}
</div>
