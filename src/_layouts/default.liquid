<!DOCTYPE html>
<html lang="en">
{%- include theme.html -%}
{% include head.html %}
<body>
  <script>
    // Apply dark mode before first paint; dark-mode.js wires up the toggle.
    try {
      if ((localStorage.getItem('mode') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark') document.body.classList.add('dark');
    } catch (e) {}
  </script>
  <div class="body-wrapper">
    {% include banner.html %}
    {% include navigation.html %}

    {% unless page.dont_render_bookshop_components %}
    <div data-bookshop-live="page" data-bookshop-props="page">
      {% bookshop page content_blocks=page.content_blocks page_theme=page.page_theme %}
    </div>
    {% endunless %}
    {{ content }}

    {% include footer.html %}

    <div class="dark-mode-toggle">
        <button type="button" id="js-dark-mode"
            class="n-button dark-mode-toggle__button">
            {% include svg/darklightmode.svg %} <span id="js-mode-label">Dark mode</span>
        </button>
    </div>
    <script type="text/javascript" src="/assets/js/dark-mode.js"></script>
    <script type="text/javascript" src="/assets/js/async-form.js"></script>

  </div>
</body>
</html>