{
  "name": "causey-website",
  "private": true,
  "description": "Bridgetown + Bookshop site for causey.app",
  "scripts": {
    "bookshop": "bookshop-browser",
    "bridgetown": "cd bridgetown && bundle exec bridgetown serve --port 6061 --unpublished",
    "start": "run-p bookshop bridgetown",
    "build": "cd bridgetown && bundle exec bridgetown build --unpublished"
  },
  "license": "MIT",
  "devDependencies": {
    "@bookshop/browser": "3.3.0",
    "@bookshop/jekyll-engine": "3.3.0",
    "@bookshop/live": "3.3.0",
    "@bookshop/generate": "3.3.0",
    "npm-run-all": "^4.1.5"
  }
}
