{
  "name": "causey-website",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Bridgetown + Bookshop site for causey.app",
  "license": "MIT",
  "scripts": {
    "bookshop": "bookshop-browser",
    "bridgetown": "bundle exec bridgetown serve --port 6061 --unpublished",
    "build": "bundle exec bridgetown build --unpublished",
    "start": "run-p bookshop bridgetown",
    "esbuild": "node esbuild.config.js --minify",
    "esbuild-dev": "node esbuild.config.js --watch"
  },
  "devDependencies": {
    "@bookshop/browser": "3.3.0",
    "@bookshop/generate": "3.3.0",
    "@bookshop/live": "3.3.0",
    "esbuild": "^0.20.2",
    "glob": "^10.3.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.29",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^15.1.0",
    "postcss-load-config": "^4.0.1",
    "postcss-preset-env": "^9.1.2",
    "read-cache": "^1.0.0",
    "sass": "^1.66.1",
    "sass-loader": "^13.3.2"
  }
}
